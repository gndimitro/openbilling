{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@openbilling/core": ["../../packages/core/src/index.ts"],
      "@openbilling/dodo": ["../../packages/dodo/src/index.ts"],
      "@openbilling/stripe": ["../../packages/stripe/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "test",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
